{
  "id": "com.custom.sac.executivepulse",
  "version": "1.0.0",
  "name": "Executive Pulse",
  "description": "Deterministic narrative engine: finds the biggest adverse contributor across one analysis dimension, renders a 3-step animated build-up with inline evidence. No AI/LLM required.",
  "newInstancePrefix": "Pulse",
  "icon": "",
  "vendor": "Custom",
  "supportsMobile": false,
  "supportsExport": false,
  "supportsBookmark": false,
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-custom-sac-executivepulse",
      "url": "/main.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "kpiLabel": {
      "type": "string",
      "default": "Revenue",
      "description": "KPI name shown in the narrative (e.g. Revenue, Costs)"
    },
    "kpiUnit": {
      "type": "string",
      "default": "",
      "description": "Unit prefix for values (e.g. € or $). Leave empty for none."
    },
    "kpiPolarity": {
      "type": "string",
      "default": "higher-is-better",
      "description": "higher-is-better (Revenue) or lower-is-better (Costs, Defects)"
    },
    "currentYear": {
      "type": "string",
      "default": "2026",
      "description": "Label for the current period (e.g. 2026)"
    },
    "priorYear": {
      "type": "string",
      "default": "2025",
      "description": "Label for the prior period (e.g. 2025)"
    },
    "dimLabel": {
      "type": "string",
      "default": "Segment",
      "description": "Display label for the analysis dimension (e.g. Region, Product, Channel)"
    }
  },
  "dataBindings": {
    "dataBinding": {
      "feeds": [
        {
          "id": "measures",
          "description": "KPI Measure (e.g. Revenue)",
          "type": "mainStructureMember"
        },
        {
          "id": "dimensions",
          "description": "1 time dim (Year) · 1 executive dim (e.g. Product Line) · 1 explanation dim (e.g. Country, optional)",
          "type": "dimension"
        }
      ]
    }
  },
  "methods": {},
  "events": {}
}
